<?xml version="1.0" encoding="UTF-8"?>
<!--
  이 사이트는 해시(#) 기반 SPA 라우팅을 사용합니다.
  검색엔진은 URL의 # 이후 부분(fragment)을 별도 페이지로 색인하지 않으므로,
  #/about, #/apply 같은 하위 경로는 sitemap에 실질적인 효과가 없어 루트만 등록했습니다.
  실제 경로(/about, /apply)로 전환하면 각 페이지를 아래 형식으로 추가하세요.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://your-domain.vercel.app/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
</urlset>
